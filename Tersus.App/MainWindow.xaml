<Window x:Class="Tersus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tersus.App.ViewModels"
        xmlns:views="clr-namespace:Tersus.App.Views"
        Title="Tersus" Width="1320" Height="860" MinWidth="1000" MinHeight="640"
        Background="{DynamicResource PageBg}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        AutomationProperties.Name="Tersus — análise de armazenamento e limpeza segura">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LargeFilesViewModel}"><views:LargeFilesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}"><views:DuplicatesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><views:CleanupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}"><views:AppsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvisorViewModel}"><views:AdvisorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="home" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="overview" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="files" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="duplicates" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="cleanup" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="apps" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="history" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="advice" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="about" />
        <KeyBinding Key="F1" Command="{Binding NavigateCommand}" CommandParameter="about" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomResetCommand}" />
    </Window.InputBindings>

    <Grid Background="{DynamicResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="ScaledRoot">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource NavBg}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,24,22,16">
                        <TextBlock Text="Tersus" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource OnNav}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Text="Análise de armazenamento e limpeza segura" FontSize="12" Foreground="{DynamicResource OnNav}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="A−" Command="{Binding ZoomOutCommand}" Style="{StaticResource SecondaryButton}" MinWidth="44" Padding="8,4"
                                    ToolTip="Diminuir o texto (Ctrl e −)" AutomationProperties.Name="Diminuir o tamanho da interface" />
                            <Button Content="A" Command="{Binding ZoomResetCommand}" Style="{StaticResource SecondaryButton}" MinWidth="44" Padding="8,4"
                                    ToolTip="Tamanho normal (Ctrl e 0)" AutomationProperties.Name="Tamanho normal da interface" />
                            <Button Content="A+" Command="{Binding ZoomInCommand}" Style="{StaticResource SecondaryButton}" MinWidth="44" Padding="8,4" Margin="0"
                                    ToolTip="Aumentar o texto (Ctrl e +)" AutomationProperties.Name="Aumentar o tamanho da interface" />
                        </StackPanel>
                        <TextBlock Text="{Binding VersionText, StringFormat='Versão {0}'}" FontSize="12" Foreground="{DynamicResource OnNav}" />
                        <TextBlock Text="Sem assinatura digital" FontSize="12" Foreground="{DynamicResource OnNav}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavItem}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Navegação principal (Ctrl e 1 a 9)">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource NavScrollBar}" />
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding IconKey, Converter={StaticResource IconGeometry}}" Fill="{DynamicResource OnNav}" Width="20" Height="20" Stretch="Uniform"
                                          Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource OnNav}" />
                                        <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{DynamicResource OnNav}" Opacity="0.85" TextWrapping="Wrap" MaxWidth="170" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Focusable="False" IsTabStop="False" x:Name="PageHost" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="18,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="16,0,0,0" TextWrapping="NoWrap"
                           Text="100% offline • nada é enviado • sem telemetria" />
                <TextBlock Style="{StaticResource Body}" FontSize="13" Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
