<UserControl x:Class="Tersus.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Tersus.App.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24,28,28" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Analisar o armazenamento" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Escolha uma unidade inteira ou uma pasta. A análise só LÊ os dados: nada é alterado, apagado nem enviado a lugar nenhum." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Onde analisar" />
                    <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource RowListItem}" BorderThickness="0" Background="Transparent" MaxHeight="280"
                             AutomationProperties.Name="Unidades disponíveis">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}" />
                                        <TextBlock Text="{Binding UsedText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Escolher outra pasta…" Command="{Binding ChooseFolderCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Atualizar lista de unidades" Command="{Binding RefreshDrivesCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding TargetText}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,16,0,0">
                <Button Content="Analisar" Command="{Binding StartCommand}" IsDefault="True" MinWidth="140" />
                <Button Style="{StaticResource SecondaryButton}" Content="Cancelar análise" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Andamento" />
                    <UniformGrid Columns="4" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Arquivos" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding FilesText}" Style="{StaticResource Body}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Pastas" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding FoldersText}" Style="{StaticResource Body}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Tamanho lógico" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding BytesText}" Style="{StaticResource Body}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Tempo" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Elapsed}" Style="{StaticResource Body}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{Binding CurrentFolder}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,8,0,0"
                               Visibility="{Binding Summary, Converter={StaticResource NullToVis}}" />
                    <WrapPanel Margin="0,12,0,0" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                        <Button Content="Ver visão geral" Command="{Binding GoOverviewCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Maiores arquivos" Command="{Binding GoFilesCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Procurar duplicados" Command="{Binding GoDuplicatesCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Limpeza de temporários" Command="{Binding GoCleanupCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BannerInfo}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Como o Tersus cuida do seu computador" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" Text="{x:Static svc:SafetyTexts.OnlyAction}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{x:Static svc:SafetyTexts.SizesAreLogical}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
