<UserControl x:Class="Tersus.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tersus.App.Controls">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Visão geral: de onde vem o espaço" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="Clique em um bloco ou em uma linha para ver o que é; duplo clique (ou Enter) abre a pasta. Tamanhos lógicos." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding HasScan, Converter={StaticResource NotBoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Ainda não há uma análise" />
                <TextBlock Style="{StaticResource Body}" Text="Faça uma análise em “Início” para ver o mapa de blocos e a lista de pastas." />
                <Button Content="Ir para Início" Command="{Binding GoHomeCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding HasScan, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="240" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="↑ Subir um nível" Command="{Binding UpCommand}" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="Abrir pasta" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedRow}" Margin="0,0,12,0"
                            ToolTip="Entra na pasta selecionada (também: duplo clique ou Enter)" />
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}" AutomationProperties.Name="Caminho atual" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource LinkButton}" Content="{Binding Label}"
                                            Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text=" › " Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                    <c:TreemapControl Items="{Binding TreemapItems}" SelectedKey="{Binding SelectedKey, Mode=OneWay}"
                                      SelectCommand="{Binding TreemapSelectedCommand}" InvokeCommand="{Binding TreemapInvokedCommand}"
                                      AutomationProperties.Name="Mapa de blocos proporcional ao tamanho das pastas"
                                      AutomationProperties.HelpText="Complemento visual. A lista abaixo traz as mesmas informações e funciona pelo teclado." />
                </Border>

                <ListBox Grid.Row="3" x:Name="RowsList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Pastas e arquivos desta pasta, do maior para o menor">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowListItem}">
                            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedRow}" />
                        <KeyBinding Key="Back" Command="{Binding UpCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Height="4" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Body}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <ContentControl Content="{Binding Explanation}" Focusable="False" IsTabStop="False" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Mostrar no Explorador" Command="{Binding ExplorerCommand}" />
                    </WrapPanel>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Por tipo de arquivo" />
                            <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Body}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource BannerInfo}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Leia com atenção" />
                            <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource BulletText}" Margin="0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
