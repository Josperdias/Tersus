<UserControl x:Class="Tersus.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Aplicativos instalados" />
            <Border Style="{StaticResource BannerInfo}" Margin="0,4,0,12">
                <TextBlock Style="{StaticResource Body}" Text="{Binding Summary}" />
            </Border>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBox Width="260" Margin="0,0,10,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Buscar por nome ou editora…"
                     AutomationProperties.Name="Filtrar por nome ou editora" ToolTip="Filtrar por nome ou editora" />
            <ComboBox Width="270" Margin="0,0,10,6" ItemsSource="{Binding SortLabels}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" AutomationProperties.Name="Ordenar a lista" />
            <Button Style="{StaticResource SecondaryButton}" Content="Atualizar" Command="{Binding RefreshCommand}" />
            <Button Style="{StaticResource SecondaryButton}" Content="Abrir “Aplicativos instalados” do Windows" Command="{Binding OpenSettingsCommand}" />
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}" CanUserSortColumns="False"
                  EnableRowVirtualization="True" AutomationProperties.Name="Programas instalados">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Programa" Binding="{Binding Name, Mode=OneWay}" Width="2*" MinWidth="170" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Editora" Binding="{Binding Publisher, Mode=OneWay}" Width="1.3*" MinWidth="120" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Versão" Binding="{Binding Version, Mode=OneWay}" Width="112" />
                <DataGridTextColumn Header="Instalado em" Binding="{Binding InstallDateText, Mode=OneWay}" Width="116" />
                <DataGridTextColumn Header="Tamanho informado" Binding="{Binding SizeText, Mode=OneWay}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <!-- The install folder is shown here (not as a table column) so the table keeps room for the sizes and dates. -->
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{Binding Selected.Location, StringFormat='Local: {0}'}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Selected.Location}"
                       Visibility="{Binding Selected.Location, Converter={StaticResource NullToVis}}" />
            <WrapPanel>
                <Button Style="{StaticResource SecondaryButton}" Content="Abrir pasta do programa selecionado" Command="{Binding ExplorerCommand}" />
                <ProgressBar IsIndeterminate="True" Width="160" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
