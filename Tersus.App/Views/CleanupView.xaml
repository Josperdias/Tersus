<UserControl x:Class="Tersus.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24,28,28" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Limpeza de temporários antigos" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                       Text="Esta é a única ação que o Tersus faz: mover para a Lixeira do Windows arquivos .tmp e .temp antigos da pasta TEMP do seu usuário. Primeiro você vê uma simulação; só depois confirma." />

            <!-- Cleanup disabled -->
            <Border Style="{StaticResource BannerDanger}" Margin="0,0,0,14" Visibility="{Binding IsEnabled, Converter={StaticResource NotBoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="⚠ Limpeza desativada neste computador" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" Text="{Binding DisabledReason}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Na dúvida o Tersus desativa só a limpeza e mantém a análise. Nada será movido." />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                <!-- Rules -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Regras desta limpeza" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding RulesLine}" />
                        <Expander Header="O que o Tersus NUNCA limpa" Margin="0,10,0,0" AutomationProperties.Name="Lista do que o Tersus nunca limpa">
                            <ItemsControl ItemsSource="{Binding NeverList}" Margin="18,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource BulletText}" Text="{Binding StringFormat='•  {0}'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Start -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsStart, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Passo 1: procurar" />
                        <TextBlock Style="{StaticResource Body}" Text="O Tersus vai olhar a pasta TEMP e listar só os arquivos que passam em todas as verificações. Procurar não altera nada." />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{Binding TempFolderText, StringFormat='Pasta TEMP: {0}'}" />
                        <Button Content="Procurar temporários antigos" Command="{Binding SearchCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" IsDefault="True" />
                    </StackPanel>
                </Border>

                <!-- Searching -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Procurando…" />
                        <ProgressBar IsIndeterminate="True" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancelar busca" Command="{Binding CancelCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Review / simulated -->
                <StackPanel Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource BannerInfo}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding SearchSummary}" />
                            <Expander Header="Por que outros arquivos foram recusados" Margin="0,8,0,0"
                                      Visibility="{Binding FoundRefusals.Count, Converter={StaticResource CountToVis}}">
                                <ItemsControl ItemsSource="{Binding FoundRefusals}" Margin="18,6,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource BulletText}">
                                                <Run Text="{Binding CountText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" × " /><Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" IsEnabled="{Binding CanEditSelection}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Passo 2: escolher o que entra na simulação" />
                            <WrapPanel>
                                <RadioButton GroupName="CleanupMode" IsChecked="{Binding IsQuick, Mode=TwoWay}" Content="Limpeza rápida (todos os elegíveis)" />
                                <RadioButton GroupName="CleanupMode" IsChecked="{Binding IsCustom, Mode=TwoWay}" Content="Personalizada (eu marco)" />
                                <RadioButton GroupName="CleanupMode" IsChecked="{Binding IsGoal, Mode=TwoWay}" Content="Por objetivo (liberar cerca de…)" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsGoal, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Objetivo:" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="100" Text="{Binding GoalText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" AutomationProperties.Name="Tamanho do objetivo" />
                                <ComboBox Width="80" Margin="8,0,0,0" ItemsSource="{Binding GoalUnits}" SelectedIndex="{Binding GoalUnitIndex, Mode=TwoWay}" AutomationProperties.Name="Unidade" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="{Binding GoalMessage}"
                                       Visibility="{Binding GoalMessage, Converter={StaticResource NullToVis}}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="Marcar todos" Command="{Binding SelectAllCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Desmarcar todos" Command="{Binding SelectNoneCommand}" />
                                <TextBlock Text="Ordenar:" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="10,0,8,0" />
                                <ComboBox Width="190" ItemsSource="{Binding SortLabels}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" AutomationProperties.Name="Ordenar a lista" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid Margin="0,14,0,0" Height="330" ItemsSource="{Binding CandidatesView}" CanUserSortColumns="False"
                              EnableRowVirtualization="True" AutomationProperties.Name="Arquivos temporários elegíveis">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Incluir" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEnabled="{Binding DataContext.CanEditSelection, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  AutomationProperties.Name="Incluir este arquivo na simulação" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding Name, Mode=OneWay}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimCell}" />
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText, Mode=OneWay}" Width="88" />
                            <DataGridTextColumn Header="Idade" Binding="{Binding AgeText, Mode=OneWay}" Width="82" />
                            <DataGridTextColumn Header="Modificado" Binding="{Binding Modified, StringFormat=dd/MM/yyyy, Mode=OneWay}" Width="104" />
                            <DataGridTextColumn Header="Pasta na TEMP" Binding="{Binding Where, Mode=OneWay}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource TrimCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,8,0,0" Text="{Binding SelectionText}" />

                    <WrapPanel Margin="0,12,0,0" Visibility="{Binding CanEditSelection, Converter={StaticResource BoolToVis}}">
                        <Button Content="Simular (nada será alterado)" Command="{Binding SimulateCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Procurar de novo" Command="{Binding SearchCommand}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{Binding PlanNote}"
                               Visibility="{Binding CanEditSelection, Converter={StaticResource BoolToVis}}" />

                    <!-- Plan (simulation result) -->
                    <Border x:Name="PlanCard" Style="{StaticResource BannerWarn}" Margin="0,14,0,0" Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Passo 3: conferir e confirmar" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding PlanHeadline}" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="{Binding PlanDetail}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{Binding PlanNote}" />
                            <ItemsControl ItemsSource="{Binding PlanRefusals}" Margin="0,8,0,0" Focusable="False" Visibility="{Binding HasPlanRefusals, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource BulletText}">
                                            <Run Text="Recusados: " /><Run Text="{Binding CountText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" × " /><Run Text="{Binding Text, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="Voltar e ajustar" Command="{Binding BackCommand}" />
                                <Button Style="{StaticResource WarnButton}" Content="Mover para a Lixeira…" Command="{Binding RecycleCommand}"
                                        AutomationProperties.HelpText="Abre uma janela de confirmação; nada é movido antes de você confirmar lá." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Executing -->
                <Border Style="{StaticResource BannerWarn}" Margin="0,14,0,0" Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Enviando à Lixeira…" />
                        <ProgressBar Minimum="0" Maximum="{Binding ProgressMax, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Parar (os arquivos restantes não serão tocados)" Command="{Binding CancelCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Done -->
                <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource BannerDanger}" Margin="0,14,0,0" Visibility="{Binding HasReportWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding ReportWarning, StringFormat='⚠ {0}'}" />
                    </Border>
                    <Border x:Name="ResultCard" Style="{StaticResource BannerOk}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Resultado" />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding ReportHeadline}" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" Text="{Binding ReportDetail}" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="{Binding ReportSpace}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{Binding ReportPreflight}"
                                       Visibility="{Binding ReportPreflight, Converter={StaticResource NullToVis}}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{Binding LogPath, StringFormat='Registro desta limpeza: {0}'}"
                                       Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Abrir a Lixeira do Windows" Command="{Binding OpenRecycleBinCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Abrir pasta dos registros" Command="{Binding OpenLogFolderCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Procurar de novo" Command="{Binding RestartCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid Margin="0,14,0,0" Height="260" ItemsSource="{Binding Results}" AutomationProperties.Name="Resultado de cada arquivo">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Resultado" Binding="{Binding OutcomeText, Mode=OneWay}" Width="190" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding Name, Mode=OneWay}" Width="1.3*" MinWidth="130" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText, Mode=OneWay}" Width="88" />
                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Message, Mode=OneWay}" Width="1.3*" MinWidth="120" ElementStyle="{StaticResource WrapCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
